package ui

import "github.com/freddie-northam/freddienortham.com/internal/content"

templ Home(v View) {
	@Layout(v) {
		<h1>{ v.Site.Name }</h1>
		<div class="prose">
			@templ.Raw(string(v.Page.Body))
		</div>
		@homeSection("Writing", "/blog/", "View all writing", v.Recent)
		@homeSection("Projects", "/projects/", "View all projects", v.Projects)
	}
}

templ homeSection(title, href, more string, pages []content.Page) {
	<section class="section">
		<h2>{ title }</h2>
		if len(pages) == 0 {
			<p class="empty">Nothing published yet.</p>
		} else {
			<ul class="rows">
				for _, p := range pages {
					@Row(p)
				}
			</ul>
		}
		<a class="more" href={ templ.SafeURL(href) }>
			{ more }
			@ArrowUpRight()
		</a>
	</section>
}
