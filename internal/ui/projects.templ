package ui

// Projects carries two blocks: roles held, then things built. Keeping them
// apart stops a four-year co-founder role reading with the same weight as a
// weekend build.
templ Projects(v View) {
	@Layout(v) {
		@PageHead(v.Section.Title, v.Lede, 0)
		<div class="section-label">
			<h2>Work</h2>
			if !v.ShowAllWork {
				<a class="pill pill-ghost" href="/projects/all/">
					View all
					@ArrowRight()
				</a>
			} else {
				<a class="pill pill-ghost" href="/projects/">
					Back
					@ArrowLeft()
				</a>
			}
		</div>
		<div class="card">
			<ul class="rows">
				for _, r := range v.Work {
					@roleRow(r)
				}
			</ul>
		</div>
		if !v.ShowAllWork {
			<div class="section-label">
				<h2>Built</h2>
				<span class="count">{ countStr(len(v.Rows)) }</span>
			</div>
			<div class="card">
				if len(v.Rows) == 0 {
					<p class="empty">Nothing published here yet.</p>
				} else {
					<ul class="rows">
						for _, r := range v.Rows {
							@Row(r)
						}
					</ul>
				}
			</div>
		}
	}
}

templ roleRow(r Role) {
	<li class="row">
		if r.URL != "" {
			<a href={ templ.SafeURL(r.URL) } rel="noopener">
				@roleBody(r)
				@ArrowUpRight()
			</a>
		} else {
			<div>
				@roleBody(r)
			</div>
		}
	</li>
}

templ roleBody(r Role) {
	<span class="row-date row-period">{ r.Period }</span>
	<span class="row-main">
		<span class="row-title">{ r.Title } · { r.Org }</span>
		<span class="row-sub wrap">{ r.Summary }</span>
	</span>
}
