package ui

// Skills lists Agent Skills, generated from SKILL.md frontmatter in the
// submodule so this page cannot drift from the source it documents.
templ Skills(v View) {
	@Layout(v) {
		@PageHead(v.Section.Title, v.Lede, len(v.Skills))
		@tabs(v)
		<div class="card">
			if len(v.Skills) == 0 {
				<p class="empty">
					No skills indexed. Add the skills repository as a submodule at
					<code>vendor/skills</code> and rebuild.
				</p>
			} else {
				<ul class="rows">
					for _, s := range v.Skills {
						<li class="row">
							<div>
								<span class="row-main">
									<span class="row-title">{ s.Name }</span>
									<span class="row-sub wrap">{ s.Description }</span>
								</span>
								<span class="install">{ s.Install }</span>
							</div>
						</li>
					}
				</ul>
			}
		</div>
	}
}

// Components is the live gallery: each component rendered from the same code
// the rest of the site uses, beside the source that produced it.
templ Components(v View) {
	@Layout(v) {
		@PageHead(v.Section.Title, v.Lede, 8)
		@tabs(v)
		<div class="gallery">
			@specimen("ArrowUpRight", "External links.", `@ArrowUpRight()`) {
				@ArrowUpRight()
			}
			@specimen("ArrowRight", "Onward navigation.", `@ArrowRight()`) {
				@ArrowRight()
			}
			@specimen("ArrowLeft", "Back.", `@ArrowLeft()`) {
				@ArrowLeft()
			}
			@specimen("Rss", "Feed link.", `@Rss()`) {
				@Rss()
			}
			@specimen("Copy", "Code block copy button.", `@Copy()`) {
				@Copy()
			}
			@specimen("LinkIcon", "Heading anchors.", `@LinkIcon()`) {
				@LinkIcon()
			}
			@specimen("Pill", "The primary control. Fully rounded, ink filled.", `<a class="pill">…</a>`) {
				<span class="pill">Get in touch</span>
			}
			@specimen("Badge", "Status, with an accent dot.", `<span class="badge">…</span>`) {
				<span class="badge"><span class="badge-dot"></span>Available</span>
			}
		</div>
	}
}

templ specimen(name, note, snippet string) {
	<section class="specimen">
		<div>
			<div class="specimen-name">{ name }</div>
			<div class="specimen-note">{ note }</div>
		</div>
		<div class="specimen-render">
			{ children... }
		</div>
		<code class="specimen-code">{ snippet }</code>
	</section>
}
