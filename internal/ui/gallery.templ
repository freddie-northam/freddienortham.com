package ui

// Skills lists Agent Skills, generated from SKILL.md frontmatter in the
// submodule so this page cannot drift from the source it documents.
templ Skills(v View) {
	@Layout(v) {
		@PageTitle(v.Section.Title, v.Lede)
		@tabs(v)
		if len(v.Skills) == 0 {
			<p class="empty">
				No skills indexed. Add the skills repository as a submodule at
				<code>vendor/skills</code> and rebuild.
			</p>
		} else {
			<ul class="rows">
				for _, s := range v.Skills {
					<li class="row">
						<div>
							<span class="row-main">
								<span class="row-title">{ s.Name }</span>
								<span class="row-sub">{ s.Description }</span>
							</span>
							<span class="row-meta install">{ s.Install }</span>
						</div>
					</li>
				}
			</ul>
		}
	}
}

// Components is the live gallery: each component rendered from the same code
// the rest of the site uses, beside the source that produced it.
templ Components(v View) {
	@Layout(v) {
		@PageTitle(v.Section.Title, v.Lede)
		@tabs(v)
		<div class="gallery">
			@specimen("ArrowUpRight", "External links and list rows.") {
				@ArrowUpRight()
			}
			@specimen("ArrowRight", "Onward navigation.") {
				@ArrowRight()
			}
			@specimen("ArrowLeft", "Back.") {
				@ArrowLeft()
			}
			@specimen("Rss", "Feed link in the footer.") {
				@Rss()
			}
			@specimen("Copy", "Code block copy button.") {
				@Copy()
			}
			@specimen("LinkIcon", "Heading anchors in articles.") {
				@LinkIcon()
			}
		</div>
	}
}

templ specimen(name, note string) {
	<section class="specimen">
		<div class="specimen-render">
			{ children... }
		</div>
		<span class="specimen-name">{ name }</span>
		<span class="specimen-note">{ note }</span>
	</section>
}
