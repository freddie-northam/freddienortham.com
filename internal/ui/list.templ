package ui

// List is the generic index: Blog, Projects, and any sub-page that lists
// things. One template, so no two sections drift apart.
templ List(v View) {
	@Layout(v) {
		@PageHead(v.Section.Title, v.Lede, len(v.Rows))
		@tabs(v)
		if len(v.Rows) == 0 {
			<div class="card">
				<p class="empty">Nothing published here yet.</p>
			</div>
		} else {
			<div class="card">
				<ul class="rows">
					for _, r := range v.Rows {
						@Row(r)
					}
				</ul>
			</div>
		}
	}
}
