package ui

import "fmt"

// Article is the generic page template: Blog posts, Projects entries, and
// every Code and Not Code sub-page. Furniture appears by length rather than
// by section.
templ Article(v View) {
	@Layout(v) {
		@PageHead(v.Page.Title, v.Page.Standfirst, 0)
		@tabs(v)
		if v.Page.Rail() != "" || v.Page.WordCount > 400 {
			<div class="article-meta">
				if v.Page.Rail() != "" {
					<span>{ v.Page.Rail() }</span>
				}
				if v.Page.WordCount > 400 {
					<span>{ fmt.Sprintf("%d min read", v.Page.ReadingMinutes()) }</span>
				}
			</div>
		}
		if v.Page.NeedsTOC() {
			<nav class="toc" aria-label="Contents">
				<p class="toc-label">Contents</p>
				<ol>
					for _, h := range v.Page.Headings {
						if h.Level == 2 {
							<li><a href={ templ.SafeURL("#" + h.ID) }>{ h.Text }</a></li>
						}
					}
				</ol>
			</nav>
		}
		<article
			class="prose"
			if v.Page.NeedsAnchors() {
				data-anchors
			}
		>
			@templ.Raw(string(v.Page.Body))
		</article>
	}
}

// SectionPage is a parent section's own page: tab bar plus its intro.
templ SectionPage(v View) {
	@Layout(v) {
		@PageHead(v.Section.Title, v.Lede, 0)
		@tabs(v)
		if v.Page.Title != "" {
			<article class="prose">
				@templ.Raw(string(v.Page.Body))
			</article>
		}
	}
}

templ NotFound(v View) {
	@Layout(v) {
		@PageHead("404", "That page has no preimage.", 0)
		<div class="card">
			<div class="card-body prose">
				<p>Nothing lives at this address.</p>
			</div>
			<div class="card-foot">
				<a class="pill" href="/">
					Back home
					@ArrowRight()
				</a>
			</div>
		</div>
	}
}
