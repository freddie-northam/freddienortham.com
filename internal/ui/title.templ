package ui

// Row is one item in a list: date or mark, title, subtitle, chevron. Used by
// every section, which is what stops Blog, Projects and Not Code drifting into
// three different list treatments.
templ Row(r RowData) {
	<li class="row">
		<a href={ templ.SafeURL(r.URL) }>
			if r.Thumb != "" {
				<span class="row-thumb"><img src={ r.Thumb } alt="" loading="lazy" decoding="async"/></span>
			} else if r.Mark {
				<span class="row-thumb"><span class="row-mark" aria-hidden="true"></span></span>
			} else if r.Date != "" {
				<span class="row-date">{ r.Date }</span>
			}
			<span class="row-main">
				<span class="row-title">{ r.Title }</span>
				if r.Sub != "" {
					<span class="row-sub">{ r.Sub }</span>
				}
			</span>
			if r.Meta != "" {
				<span class="row-date">{ r.Meta }</span>
			}
			@ArrowRight()
		</a>
	</li>
}
