package ui

import "github.com/freddie-northam/freddienortham.com/internal/content"

// PageTitle is the page opener. Nothing on this site is display type: the
// largest thing anywhere is 24px, so a page announces itself by saying what
// it is rather than by shouting.
templ PageTitle(title, lede string) {
	<h1>{ title }</h1>
	if lede != "" {
		<p class="lede">{ lede }</p>
	}
}

// Row is one item in any list. A single row treatment across Blog, Projects
// and Work is what stops three sections drifting into three list styles.
templ Row(p content.Page) {
	<li class="row">
		<a href={ templ.SafeURL(p.URL()) }>
			if p.Thumb != "" {
				<span class="row-thumb"><img src={ p.Thumb } alt="" loading="lazy" decoding="async"/></span>
			}
			<span class="row-main">
				<span class="row-title">{ p.Title }</span>
				if p.Standfirst != "" {
					<span class="row-sub">{ p.Standfirst }</span>
				}
			</span>
			if p.Rail() != "" {
				<span class="row-meta">{ p.Rail() }</span>
			}
			<span class="row-go">
				@ArrowUpRight()
			</span>
		</a>
	</li>
}
